+    /* Resolved once, unlocked. Two threads racing here both call
+     * GetProcAddress and both store the same value, so this is benign: it can
+     * make a diagnostic slower, never wrong. A lock would be a real
+     * dependency on a PE-side lock this file does not otherwise have. */
+    static WMT_PFN_dbg_output s_out;
+    static int s_tried;
+    if (!s_tried) {
