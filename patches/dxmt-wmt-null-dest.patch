+/* Metal API validation, requested at load rather than at device creation.
+ *
+ * The app's own window view returns a CAMetalLayer from layerClass, and creating
+ * a CAMetalLayer creates a Metal device with it. That happens before winemetal
+ * ever calls MTLCreateSystemDefaultDevice, so a setenv placed just above that
+ * call is too late: MTL_DEBUG_LAYER is read once, when the device is made, and
+ * would silently do nothing. A load-time constructor runs at dylib load, ahead
+ * of any Metal object in the process, which is the earliest point this library
+ * has.
+ *
+ * Opt-in via MADEIRA_MTL_DEBUG_LAYER, because validation costs performance. It
+ * reports what it did, and whether it was asked for, so a run that looks clean
+ * is not mistaken for a run where validation was active and silent. */
+int wmt_mtl_debug_requested;
+
+__attribute__((constructor)) static void
+wmt_mtl_debug_early(void) {
+  /* Read the config file, not the environment. WineProcessBridge.m exports the
+   * env.NAME lines from madeira.cfg, but that runs after the guest starts --
+   * later than a dylib-load constructor. getenv here would always be empty and
+   * the setting could never be turned on from the cfg file at all. */
+  char dir[512];
+  int have_dir = madeira_cfg__dir(dir, sizeof dir);
+  fprintf(stderr, "[mtl-debug] load: cfg-dir-source=%s dir=%s found=%s "
+                  "HOME=%s MADEIRA_DOCS_DIR=%s\n",
+          madeira_cfg_dir_source(), have_dir ? dir : "(unresolved)",
+          have_dir ? "yes" : "NO",
+          getenv("HOME") ? getenv("HOME") : "(unset)",
+          getenv("MADEIRA_DOCS_DIR") ? getenv("MADEIRA_DOCS_DIR") : "(unset)");
+  if (!have_dir) {
+    /* Say this plainly. An unresolved path and a setting that is off look
+     * identical from the outside, and a run where the layer was never asked for
+     * would otherwise be read as a validation run. */
+    fprintf(stderr, "[mtl-debug] requested=0 UNRESOLVED -- the config path could not be "
+                    "resolved at dylib load, so this build cannot enable validation from "
+                    "madeira.cfg and any run below is a baseline run, not a validation run\n");
+    return;
+  }
+  int want = (int)madeira_cfg_int("MADEIRA_MTL_DEBUG_LAYER", 0);
+  if (!want) {
+    fprintf(stderr, "[mtl-debug] requested=0 (madeira.cfg parsed, "
+                    "MADEIRA_MTL_DEBUG_LAYER absent or 0)\n");
+    return;
+  }
+  wmt_mtl_debug_requested = 1;
+  setenv("MTL_DEBUG_LAYER", "1", 1);
+  fprintf(stderr, "[mtl-debug] requested=1 parsed from %s/madeira.cfg, setenv "
+                  "MTL_DEBUG_LAYER=1 at dylib load, before any Metal object exists\n",
+          dir);
+}
