+/* ---- last blit commands, for a fault inside the driver -------------------
+ *
+ * Run 2 of the 15:32-15:40 logs reached objc_retain inside AGX with a pointer
+ * outside the JIT pool, from _MTLBlitCommandEncoder_encodeCommands, shortly
+ * after live memory fell from about 2417 MB to about 498 MB in one burst. That
+ * establishes a handle used after its backing went away and says nothing about
+ * which handle or which command.
+ *
+ * This copies bytes out of the command chain into a fixed static array. No
+ * allocation, no refcount, nothing added to or removed from any lifetime, so it
+ * cannot change the behaviour it observes -- which is the only way a diagnostic
+ * like this is safe to leave switched on.
+ *
+ * wmt_blit_ring_dump() is the reader and is called from the crash path. */
+#define WMT_BLIT_RING 64
+
+/* A blit command record, decoded rather than raw: the point of Issue B is to
+   know WHICH resource was used after it went away, and a hex dump of the struct
+   makes the reader do the decoding. Layout and names match the
+   wmtcmd_blit_copy_from_texture_to_* structs in winemetal.h; the fields are
+   copied out by value and nothing here owns or retains anything. */
+struct wmt_blit_rec {
+  uint32_t type;
+  uint32_t valid;          /* which of src/dst/level/size were filled in */
+  obj_handle_t encoder;
+  obj_handle_t src;
+  obj_handle_t dst;
+  uint32_t level, slice;
+  uint64_t ox, oy, oz;     /* WMTOrigin; 64-bit in winemetal.h, not 32 */
+  uint64_t w, h, d;        /* WMTSize, likewise */
+};
+
+#define WMT_BLIT_SRC 1u
+#define WMT_BLIT_DST 2u
+#define WMT_BLIT_SIZE 4u
+
+static struct wmt_blit_rec g_blit_ring[WMT_BLIT_RING];
+static unsigned g_blit_ring_at;      /* racy on purpose; see the note below */
+
+static void
+wmt_blit_ring_record(obj_handle_t encoder, const struct wmtcmd_base *head) {
+  unsigned n = 0;
+  for (const struct wmtcmd_base *c = head; c && n < WMT_BLIT_RING; n++) {
+    /* next.ptr is void*, so the chain hop needs the cast the existing code does
+       elsewhere; this loop cannot put it in the for-expression and still compile. */
+    const struct wmtcmd_base *next_cmd = (const struct wmtcmd_base *)c->next.ptr;
+    struct wmt_blit_rec *r = &g_blit_ring[g_blit_ring_at];
+    unsigned at = g_blit_ring_at;
+    g_blit_ring_at = (at + 1) % WMT_BLIT_RING;
+    memset(r, 0, sizeof *r);
+    r->type = c->type;
+    r->encoder = encoder;
+
+    switch ((enum WMTBlitCommandType)c->type) {
+    case WMTBlitCommandCopyFromTextureToBuffer: {
+      const struct wmtcmd_blit_copy_from_texture_to_buffer *b =
+        (const struct wmtcmd_blit_copy_from_texture_to_buffer *)c;
+      r->src = b->src; r->dst = b->dst; r->level = b->level; r->slice = b->slice;
+      r->w = b->size.width; r->h = b->size.height; r->d = b->size.depth;
+      r->valid = WMT_BLIT_SRC | WMT_BLIT_DST | WMT_BLIT_SIZE;
+      break;
+    }
+    case WMTBlitCommandCopyFromTextureToTexture: {
+      /* Destination level/slice/size are what the copy writes, so they are the
+         interesting half for a destination that was freed; the source fields
+         exist too but the fault was on the side being written. */
+      const struct wmtcmd_blit_copy_from_texture_to_texture *b =
+        (const struct wmtcmd_blit_copy_from_texture_to_texture *)c;
+      r->src = b->src; r->dst = b->dst;
+      r->level = b->dst_level; r->slice = b->dst_slice;
+      /* The destination half of this struct carries origin, NOT size: the copy
+       * is the same size as the source, and there is no dst_size member. The
+       * build caught this before the IPA was produced. */
+      r->w = b->src_size.width; r->h = b->src_size.height; r->d = b->src_size.depth;
+      r->valid = WMT_BLIT_SRC | WMT_BLIT_DST | WMT_BLIT_SIZE;
+      break;
+    }
+    default:
+      /* Unknown or handle-free command: the type alone is still worth having,
+         and valid stays 0 so the reader knows not to trust the handles. */
+      break;
+    }
+    c = next_cmd;
+  }
+}
+
+/* Plain C, no extern "C" -- this file is a .c and is compiled as C. The build
+ * said "expected identifier or '('" at the linkage specifier, which is the C++
+ * form. The consumer on the other side, build/ntdll-unix/signal_arm64_ios.c, is
+ * also C and declares this weakly as `extern void wmt_blit_ring_dump(void)`, so
+ * plain C linkage already produces the name it looks for. The C++ spelling is
+ * only needed for dxbc_converter.cpp, which is where the other dumper lives. */
+void
+wmt_blit_ring_dump(void) {
+  /* The tick, so these lines can be lined up against [footprint] and the
+   * exception report, which are on a different clock and a different stream. */
+  uint64_t tick = mach_absolute_time();
+  fprintf(stderr,
+          "[blit-ring t=%llu] %u entries, decoded. Oldest first; newest is last.\n"
+          "[blit-ring t=%llu] racy across encode threads by construction: the index\n"
+          "[blit-ring t=%llu] is a plain increment and records are filled without a\n"
+          "[blit-ring t=%llu] lock. A lost or duplicated entry is possible; it cannot\n"
+          "[blit-ring t=%llu] corrupt anything -- fixed array, no pointers, no ownership.\n",
+          (unsigned long long)tick, WMT_BLIT_RING,
+          (unsigned long long)tick, (unsigned long long)tick,
+          (unsigned long long)tick, (unsigned long long)tick);
+  for (unsigned i = 0; i < WMT_BLIT_RING; i++) {
+    unsigned idx = (g_blit_ring_at + i) % WMT_BLIT_RING;
+    const struct wmt_blit_rec *r = &g_blit_ring[idx];
+    if (!r->type && !r->encoder) continue;
+    if (r->valid & WMT_BLIT_SRC)
+      fprintf(stderr, "[blit-ring t=%llu] type=%u enc=%llu src=%llu ",
+              (unsigned long long)tick, r->type,
+              (unsigned long long)r->encoder, (unsigned long long)r->src);
+    if (r->valid & WMT_BLIT_DST)
+      fprintf(stderr, "dst=%llu ", (unsigned long long)r->dst);
+    if (r->valid & WMT_BLIT_SIZE)
+      fprintf(stderr, "level=%u slice=%u size=%llux%llux%llu ", r->level, r->slice,
+              (unsigned long long)r->w, (unsigned long long)r->h, (unsigned long long)r->d);
+    fprintf(stderr, "\n");
+  }
+}
+
 static NTSTATUS
