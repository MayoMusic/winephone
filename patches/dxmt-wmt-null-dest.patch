+/* ---- last DXBC blob seen by SM50Initialize ---------------------------------
+ *
+ * Run 3 of the 15:32-15:40 device logs died in read_control_flow with a
+ * memmove whose destination register was 0, copying 0x3bb0 bytes. Without the
+ * bytecode there is no way to replay it, and a shader parser bug will not
+ * reproduce itself from a description of a fault address.
+ *
+ * Deliberately plain: no allocation, no ownership, no destructor. The pointer
+ * is only valid while the caller owns the bytecode, which is the window the
+ * fault falls in, so a dump taken at the fault is correct and a dump taken
+ * later is not -- hence the note in the header that it must be read from the
+ * crash path.
+ */
+static const void *g_wmt_last_dxbc;
+static size_t g_wmt_last_dxbc_size;
+
+extern "C" void wmt_airconv_note_dxbc(const void *p, size_t n) {
+  g_wmt_last_dxbc = p;
+  g_wmt_last_dxbc_size = n;
+}
+
+extern "C" const void *wmt_airconv_last_dxbc(void) { return g_wmt_last_dxbc; }
+extern "C" size_t wmt_airconv_last_dxbc_size(void) { return g_wmt_last_dxbc_size; }
+
+extern "C" int
+wmt_airconv_dump_last_dxbc(const char *dir) {
+  if (!g_wmt_last_dxbc || !g_wmt_last_dxbc_size || !dir || !*dir) return 0;
+  /* FNV-1a over the bytes, so a blob found later can be matched to the log line
+   * that named it without keeping the whole shader in memory for comparison. */
+  uint64_t h = 1469598103934665603ull;
+  const uint8_t *p = (const uint8_t *)g_wmt_last_dxbc;
+  for (size_t i = 0; i < g_wmt_last_dxbc_size; i++) {
+    h ^= p[i];
+    h *= 1099511628211ull;
+  }
+  char path[1024];
+  snprintf(path, sizeof path, "%s/wmt-last-dxbc.bin", dir);
+  FILE *f = fopen(path, "wb");
+  if (!f) {
+    fprintf(stderr, "[dxbc-dump] could not open %s\n", path);
+    return 0;
+  }
+  size_t w = fwrite(g_wmt_last_dxbc, 1, g_wmt_last_dxbc_size, f);
+  fclose(f);
+  fprintf(stderr, "[dxbc-dump t=%llu] path=%s bytes=%zu fnv1a=%016llx written=%zu\n",
+          (unsigned long long)mach_absolute_time(), path, g_wmt_last_dxbc_size,
+          (unsigned long long)h, w);
+  return (int)w;
+}
+
 AIRCONV_API int SM50Initialize(
   const void *pBytecode, size_t BytecodeSize, sm50_shader_t *ppShader,
   MTL_SHADER_REFLECTION *pRefl, sm50_error_t *ppError
 ) {
+  /* Record which blob is being parsed before doing anything with it.
+   *
+   * Run 3 of the 15:32-15:40 logs faulted inside read_control_flow with a
+   * memmove whose destination was NULL, copying 15280 bytes. The log does not
+   * say whether that was an allocation that returned NULL or a container that
+   * believes it has capacity while holding a null pointer, and this does not
+   * pretend to know: it only makes the input recoverable.
+   *
+   * Two plain globals, no allocation and no ownership, so nothing here can
+   * change what the parser does. wmt_airconv_last_dxbc() exposes them for a
+   * crash dump, and wmt_airconv_dump_last_dxbc() writes it out. The pointer is
+   * only valid while the caller owns the bytecode, which is exactly the window
+   * during which the fault happens. */
+  wmt_airconv_note_dxbc(pBytecode, BytecodeSize);
+
   int ret = parse_shader(pBytecode, BytecodeSize, ppShader, pRefl, ppError);
   if (ret)
     return ret;
