+
+/* Assembles one line and hands it to Wine's log. Returns 1 if it got there.
+ *
+ * Every format string in this file is a literal with at most six numeric
+ * fields, so nothing here approaches the 1024-byte body; a line that somehow
+ * did is marked "[truncated]" rather than silently cut, because a diagnostic
+ * that stops halfway is worse than one that says it stopped. */
+static int wmt_pe_warn(const char *fmt, ...)
+{
+    char body[WMT_PE_WARN_MAX];
+    char line[WMT_PE_WARN_MAX + 32];
+    size_t off, n;
+    va_list args;
+    WMT_PFN_dbg_output out = wmt_pe_dbg_output();
+    int written;
